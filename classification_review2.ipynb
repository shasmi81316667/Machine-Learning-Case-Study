   "source": [
   
    "import pandas as pd\n",
    "df = pd.read_csv('faults_with_missing.csv')\n",
   

    "fault_cols = ['Pastry', 'Z_Scratch', 'K_Scatch', 'Stains', 'Dirtiness', 'Bumps', 'Other_Faults']\n",
    "print(f'Shape: {df.shape} | Duplicate rows: {df.duplicated().sum()}')\n",
    "display(df.head())\n",
    "display(pd.DataFrame({'dtype': df.dtypes.astype(str), 'missing': df.isna().sum(), 'missing_%': (100 * df.isna().mean()).round(2)}))\n",
    "assert (df[fault_cols].sum(axis=1) == 1).all(), 'Each row should have exactly one fault label.'\n",
    "y_names = df[fault_cols].idxmax(axis=1)\n",
    "label_encoder = LabelEncoder()\n",
    "y = pd.Series(label_encoder.fit_transform(y_names), index=df.index, name='Fault class code')\n",
    "X = df.drop(columns=fault_cols)\n",
    "display(y_names.value_counts().rename_axis('Fault class').to_frame('Count'))\n"
   ]
  },
