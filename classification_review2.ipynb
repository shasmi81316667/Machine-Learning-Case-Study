    "# Update the consolidated table only when a tuned version improves weighted F1.\n",
    "# This preserves one row per algorithm and avoids claiming an improvement when none occurred.\n",
    "for base_name, tuned_metrics, baseline_f1 in [\n",
    "    ('Random Forest', tuned_row, rf_baseline),\n",
    "    ('Bagging (Decision Tree)', tuned_bagging_row, bag_baseline),\n",
    "]:\n",
    "    if tuned_metrics['F1 (weighted)'] > baseline_f1:\n",
    "        comparison.loc[comparison.Algorithm == base_name, list(tuned_metrics.keys())[1:]] = [tuned_metrics[k] for k in list(tuned_metrics.keys())[1:]]\n",
    "        comparison.loc[comparison.Algorithm == base_name, 'Algorithm'] = tuned_metrics['Algorithm']\n",
    "    else:\n",
    "        print(f'No test weighted-F1 improvement for {base_name}; retaining the baseline row in the final comparison.')\n",
    "comparison = comparison.sort_values('F1 (weighted)', ascending=False).reset_index(drop=True)\n",
    "display(comparison.round(4))\n",
    
   ]
