    "rows=[]; fitted={}; preds={}\n",
    "for name,model in models.items():\n",
    "    print('Fitting',name)\n",
    "    model.fit(X_train,y_train); pred=model.predict(X_test)\n",
    "    fitted[name]=model; preds[name]=pred\n",
    "    row={'Algorithm':name,'Accuracy':accuracy_score(y_test,pred),\n",
    "         'Precision (weighted)':precision_score(y_test,pred,average='weighted',zero_division=0),\n",
    "         'Recall (weighted)':recall_score(y_test,pred,average='weighted',zero_division=0),\n",
    "         'F1 (weighted)':f1_score(y_test,pred,average='weighted',zero_division=0),'ROC-AUC (OvR weighted)':np.nan}\n",
    "    if hasattr(model,'predict_proba'):\n",
    "        try: row['ROC-AUC (OvR weighted)']=roc_auc_score(y_test,model.predict_proba(X_test),labels=model.classes_,multi_class='ovr',average='weighted')\n",
    "        except ValueError: pass\n",
    "    rows.append(row)\n",
    "comparison=pd.DataFrame(rows).sort_values('F1 (weighted)',ascending=False).reset_index(drop=True)\n",
    "display(comparison.round(4))"
   ]
