    "# Tune Random Forest (also used for feature-importance visualisation below).\n",
    "rf = pipe(RandomForestClassifier(class_weight='balanced', random_state=RANDOM_STATE, n_jobs=-1))\n",
    "rf_grid = {\n",
    "    'model__n_estimators': [150, 250],\n",
    "    'model__max_depth': [None, 12, 20],\n",
    "    'model__min_samples_split': [2, 5]\n",
    "}\n",
    "cv = StratifiedKFold(n_splits=3, shuffle=True, random_state=RANDOM_STATE)\n",
    "rf_search = GridSearchCV(rf, rf_grid, scoring='f1_weighted', cv=cv, n_jobs=-1, verbose=1)\n",
    "rf_search.fit(X_train, y_train)\n",
    "tuned = rf_search.best_estimator_\n",
    "tuned_pred = tuned.predict(X_test)\n",
    "tuned_prob = tuned.predict_proba(X_test)\n",
    "\n",
    "def evaluate_classifier(name, estimator, prediction, probabilities):\n",
    "    return {\n",
    "        'Algorithm': name,\n",
    "        'Accuracy': accuracy_score(y_test, prediction),\n",
    "        'Precision (weighted)': precision_score(y_test, prediction, average='weighted', zero_division=0),\n",
    "        'Recall (weighted)': recall_score(y_test, prediction, average='weighted', zero_division=0),\n",
    "        'F1 (weighted)': f1_score(y_test, prediction, average='weighted', zero_division=0),\n",
    "        'ROC-AUC (OvR weighted)': roc_auc_score(y_test, probabilities, labels=estimator.classes_, multi_class='ovr', average='weighted')\n",
    "    }\n",
    "\n",
    "tuned_row = evaluate_classifier('Random Forest (tuned)', tuned, tuned_pred, tuned_prob)\n",
    "rf_baseline = float(comparison.loc[comparison.Algorithm == 'Random Forest', 'F1 (weighted)'].iloc[0])\n",
    "print('Random Forest best parameters:', rf_search.best_params_)\n",
    "print(f'Random Forest weighted F1 — baseline: {rf_baseline:.4f}; tuned: {tuned_row[\"F1 (weighted)\"]:.4f}')\n",
    "display(pd.DataFrame([tuned_row]).set_index('Algorithm').round(4))\n",
    "\n",
    "# Tune Bagging, which was the best baseline in the uploaded notebook results.\n",
    "bag = pipe(BaggingClassifier(estimator=DecisionTreeClassifier(random_state=RANDOM_STATE), random_state=RANDOM_STATE, n_jobs=-1))\n",
    "bag_grid = {\n",
    "    'model__n_estimators': [50, 100, 150],\n",
    "    'model__estimator__max_depth': [None, 10, 20],\n",
    "    'model__estimator__min_samples_leaf': [1, 2]\n",
    "}\n",
    "bag_search = GridSearchCV(bag, bag_grid, scoring='f1_weighted', cv=cv, n_jobs=-1, verbose=1)\n",
    "bag_search.fit(X_train, y_train)\n",
    "tuned_bagging = bag_search.best_estimator_\n",
    "bag_pred = tuned_bagging.predict(X_test)\n",
    "bag_prob = tuned_bagging.predict_proba(X_test)\n",
    "tuned_bagging_row = evaluate_classifier('Bagging (Decision Tree, tuned)', tuned_bagging, bag_pred, bag_prob)\n",
    "bag_baseline = float(comparison.loc[comparison.Algorithm == 'Bagging (Decision Tree)', 'F1 (weighted)'].iloc[0])\n",
    "print('Bagging best parameters:', bag_search.best_params_)\n",
    "print(f'Bagging weighted F1 — baseline: {bag_baseline:.4f}; tuned: {tuned_bagging_row[\"F1 (weighted)\"]:.4f}')\n",
    "display(pd.DataFrame([tuned_bagging_row]).set_index('Algorithm').round(4))\n"
   ]
